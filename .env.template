# Spotify Web API integration — fill these in.
#
# Create an app at https://developer.spotify.com/dashboard, then copy its
# Client ID / Secret here. Add the redirect URI below to the app's
# "Redirect URIs" allow-list (must match exactly).
#
# After filling in and starting the app, visit /spotify/login once to
# authorize the `user-read-currently-playing` scope. The refresh token is
# then persisted to SPOTIFY_TOKEN_FILE so restarts re-auth automatically.

# Required
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public deployment URL (including any path prefix). The Spotify redirect URI
# is derived from this as "<APP_BASE_URL>/spotify/callback" — register that
# exact value in the Spotify app's "Redirect URIs" allow-list.
# Example: https://max.hadiko.de/licht/
#APP_BASE_URL=

# Optional — defaults shown. Uncomment to override.
# Set this to override the redirect URI explicitly (otherwise it is derived
# from APP_BASE_URL, falling back to the local dev address below).
#SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/spotify/callback

# Where the persisted refresh token is stored (relative to the working dir).
#SPOTIFY_TOKEN_FILE=spotify_token.txt

# Case-insensitive substrings matched against the playing track's title to
# trigger the corresponding FX show. Set to empty to disable a rule.
#SPOTIFY_WOULD_YOU_MATCH=would you
#SPOTIFY_PRADA_MATCH=prada
#SPOTIFY_DJ_TURN_IT_UP_MATCH=turn it up
#SPOTIFY_SCHREI_NACH_LIEBE_MATCH=schrei nach liebe
